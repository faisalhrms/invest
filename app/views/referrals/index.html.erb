<div class="container-fluid">
  <div class="col-lg-12">
    <div class="iq-card iq-card-block iq-card-stretch iq-card-height">
      <div class="iq-card-header d-flex justify-content-between">
        <div class="iq-header-title">
          <h4 class="card-title">Teams</h4>
        </div>
      </div>

      <!-- Filter Form Start -->
      <% if current_user.user_type == "administrator" %>
        <div class="iq-card-body">
          <%= form_with url: referrals_path, method: :get, local: true, class: 'form-inline mb-4' do |f| %>
            <div class="form-group">
              <%= f.label :filter, 'Filter by:', class: 'mr-2' %>
              <%= f.select :filter, options_for_select([
                                                         ['Teams', 'all'],
                                                         ['Users who bought packages', 'bought_packages'],
                                                         ['Users who joined via referrals', 'via_referrals'],
                                                         ['Users who signed up but did not buy any plan', 'no_plan']
                                                       ], params[:filter]), {}, class: 'form-control mr-2' %>
            </div>
            <%= f.submit 'Apply', class: 'btn btn-primary' %>
          <% end %>
        </div>
      <% end %>
      <!-- Filter Form End -->

      <div class="iq-card-body">
        <div class="table-responsive">
          <table class="table mb-2 mt-2 table-borderless">
            <thead>
            <tr>
              <th scope="col" class="font-weight-bold">Full Name</th>
              <th scope="col" class="font-weight-bold">Email</th>
              <th scope="col" class="font-weight-bold">Referred By</th>
              <th scope="col" class="font-weight-bold">Referral Count</th>
              <th scope="col" class="font-weight-bold">Transaction History</th>
              <th scope="col" class="font-weight-bold">Plan</th>
              <th scope="col" class="font-weight-bold">Deposit Amount</th>
              <th scope="col" class="font-weight-bold">Status</th>
            </tr>
            </thead>
            <tbody>
            <% if @referrals.any? %>
              <% @referrals.each do |referral| %>
                <tr>
                  <!-- Full Name -->
                  <td><%= referral.full_name %></td>

                  <!-- Email -->
                  <td><%= referral.email %></td>

                  <!-- Referred By -->
                  <td>
                    <%= referral.referred_by_user.present? ? referral.referred_by_user.full_name : "Direct Signup" %>
                  </td>

                  <!-- Referral Count with View Button -->
                  <td>
                    <a href="#" class="btn btn-sm btn-info ml-2" data-toggle="modal" data-target="#referralDetailsModal" data-id="<%= referral.id %>">
                      <i class="ri-eye-fill"></i> <%= referral.referred_users.count %>
                    </a>
                  </td>

                  <!-- Transaction History -->
                  <td>
                    <a href="#" class="btn btn-sm btn-warning ml-2" data-toggle="modal" data-target="#referralDetailsModal1" data-id="<%= referral.id %>">
                      <i class="ri-time-fill"></i>
                    </a>
                  </td>

                  <!-- Plan Details -->
                  <td>
                    <% if referral.purchases.present? %>
                      <% plan_names = referral.purchases.map do |purchase|
                        if purchase.investment_plan_id
                          purchase.investment_plan.name
                        elsif purchase.trading_plan_id
                          purchase.trading_plan.name
                        elsif purchase.staking_id
                          purchase.staking.name
                        end
                      end.compact %>
                      <%= plan_names.uniq.join(", ") %>
                    <% else %>
                      No Plan
                    <% end %>
                  </td>

                  <!-- Total Deposit Amount -->
                  <td>
                    <% total_deposit = referral.purchases.sum(&:deposit_amount) %>
                    <%= number_to_currency(total_deposit, unit: "$") %>
                  </td>

                  <!-- Status with Badge -->
                  <td>
                      <span class="badge rounded-pill <%= referral.is_active ? 'badge-info' : 'badge-danger' %>">
                        <%= referral.is_active ? 'Active' : 'Inactive' %>
                        <span class="ri-<%= referral.is_active ? 'check-fill' : 'user-unfollow-line' %> mx-1"></span>
                      </span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center">No users found.</td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Modal and JavaScript remain the same -->

<!-- Modal for Referral Details -->
<!-- Modal for displaying referral details -->
<div class="modal fade" id="referralDetailsModal" tabindex="-1" role="dialog" aria-labelledby="referralDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="referralDetailsModalLabel">Referral Details</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div id="referral-details-content">
          <p>Loading referral details...</p>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Modal for displaying transaction history -->
<div class="modal fade" id="referralDetailsModal1" tabindex="-1" role="dialog" aria-labelledby="referralDetailsModalLabel1" aria-hidden="true">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="referralDetailsModalLabel1">Transaction History</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div id="referral-details-content1">
          <p>Loading Transaction History...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    $(document).ready(function() {
        // Use jQuery to dynamically load referral details when the modal is triggered
        $('#referralDetailsModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);  // Button that triggered the modal
            var userId = button.data('id');  // Extract the user ID from the data-* attribute

            // AJAX request to fetch referral details
            $.ajax({
                url: '/referrals/' + userId + '/referral_details',
                method: 'GET',
                dataType: 'html',
                success: function(response) {
                    // Load response into the modal's content
                    $('#referral-details-content').html(response);
                },
                error: function() {
                    // Display error message in case of failure
                    $('#referral-details-content').html('<p class="text-danger">Unable to load referral details.</p>');
                }
            });
        });
    });

    $(document).ready(function() {
        // Use jQuery to dynamically load referral details when the modal is triggered
        $('#referralDetailsModal1').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);  // Button that triggered the modal
            var userId = button.data('id');  // Extract the user ID from the data-* attribute

            // AJAX request to fetch referral details
            $.ajax({
                url: '/referrals/' + userId + '/transaction_history',
                method: 'GET',
                dataType: 'html',
                success: function(response) {
                    // Load response into the modal's content
                    $('#referral-details-content1').html(response);
                },
                error: function() {
                    // Display error message in case of failure
                    $('#referral-details-content1').html('<p class="text-danger">Unable to load transaction history.</p>');
                }
            });
        });
    });

</script>
