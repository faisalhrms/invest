<div class="container-fluid">
  <div class="col-lg-12">
    <div class="iq-card iq-card-block iq-card-stretch iq-card-height">
      <div class="iq-card-header d-flex justify-content-between">
        <% if @can_create %>
          <button class="btn btn-primary mr-2" data-toggle="modal" data-target="#userModal">
            <i class="ri-add-fill"><span class="pl-1">Add New</span></i>
          </button>
          <%= form_with url: new_team_leader_path, method: :post, local: true do |form| %>
            <div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-hidden="true">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">Add New Team Leader</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="member_name">Member Name <span style="color: red">*</span></label>
                          <%= form.text_field :member_name, class: 'form-control', placeholder: "Enter Member Name", required: true %>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="country">Country <span style="color: red">*</span></label>
                          <%= form.select :country, options_for_select(@countries.map { |country| ["#{country[:flag]} #{country[:name]}", country[:code]] }), { prompt: 'Select a country' }, class: 'form-control', required: true %>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="date">Date <span style="color: red">*</span></label>
                          <%= form.date_field :date, class: 'form-control', required: true %>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="investment_amount">Investment Amount <span style="color: red">*</span></label>
                          <%= form.number_field :investment_amount, class: 'form-control', placeholder: "Enter Investment Amount", required: true %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <%= form.submit 'Save', class: 'btn btn-primary' %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>

        <div class="iq-header-title">
          <h4 class="card-title"><%= @sub_module_name.gsub('_', ' ').titleize %></h4>
        </div>
      </div>
      <div class="iq-card-body">
        <div class="table-responsive">
          <table id="datatable" class="table mb-0 mt-2 table-borderless">
            <thead>
            <tr>
              <th>Member Name</th>
              <th>Country</th>
              <th>Date</th>
              <th>Investment Amount</th>
              <th>Actions</th>
            </tr>
            </thead>
            <% if @team_leaders.present? %>
              <tbody>
              <% @team_leaders.order(id: :desc).each do |leader| %>
                <tr>
                  <td><%= leader.member_name %></td>
                  <td><%= leader.country %></td>
                  <td><%= leader.date %></td>
                  <td><%= number_to_currency(leader.investment_amount, unit: "$") %></td>
                  <td>
                    <% if @can_edit %>
                      <a data-toggle="modal" data-target="#editModal<%= leader.id %>" class="animate">
                        <i class="ri-ball-pen-fill text-success pr-1 font-size-18"></i>
                      </a>
                    <% end %>
                    <% if @can_delete %>
                      <a data-toggle="modal" data-target="#modalBootstrapdelete<%= leader.id %>" class="animate">
                        <i class="ri-delete-bin-5-line text-danger font-size-18"></i>
                      </a>
                    <% end %>
                  </td>
                  <%= render 'edit_modal', leader: leader if @can_edit %>
                  <%= render 'delete_modal', leader: leader if @can_delete %>
                </tr>
              <% end %>
              </tbody>
            <% end %>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
    .animate i {
        transition: all 0.3s ease;
    }

    .animate:hover i {
        font-size: 22px;
    }
</style>
<script>
    function updateFileName(input) {
        var fileName = input.files[0].name;
        var label = input.nextElementSibling;
        label.innerText = fileName;
    }
</script>
